@model IEnumerable<Book2Screen.Models.Movie>
<main>
    <article>

        <!--
      - #HERO
    -->

        <section class="hero">
            <div class="container">

                <div class="hero-content">

                    <p class="hero-subtitle">Book2Screen</p>

                    <h1 class="h1 hero-title">
                        Movies Based on <strong>Books</strong>,         TVs Shows,  & More.
                    </h1>

                    <div class="meta-wrapper">

                        <div class="badge-wrapper">
                            <div class="badge badge-fill">PG 18</div>

                            <div class="badge badge-outline">HD</div>
                        </div>

                        <div class="ganre-wrapper">
                            <a href="#">Romance,</a>

                            <a href="#">Drama</a>
                        </div>

                        <div class="date-time">

                            <div>
                                <ion-icon name="calendar-outline"></ion-icon>

                                <time datetime="2022">2022</time>
                            </div>

                            <div>
                                <ion-icon name="time-outline"></ion-icon>

                                <time datetime="PT128M">128 min</time>
                            </div>

                        </div>

                    </div>

                    <button class="btn btn-primary">
                        <ion-icon name="play"></ion-icon>

                        <span>Watch now</span>
                    </button>

                </div>

            </div>
        </section>



        <!--
      - #UPCOMING
    -->

        <section class="upcoming">
            <div class="container">

                <div class="flex-wrapper">

                    <div class="title-wrapper">
                        <p class="section-subtitle">Online Streaming</p>

                        <h2 class="h2 section-title">Upcoming Movies</h2>
                    </div>

                    @*<ul class="filter-list">

                        <li>
                            <button class="filter-btn">Movies</button>
                        </li>

                        <li>
                            <button class="filter-btn">TV Shows</button>
                        </li>

                        <li>
                            <button class="filter-btn">Anime</button>
                        </li>

                    </ul>*@

                </div>
                <div class="container">
                    <ul class="movies-list">
                        @foreach (var item in Model.Where(m => (m.Releasedate == null ? DateTime.MinValue : m.Releasedate) > DateTime.Now))
                        {
                            <li>
                                <div class="movie-card">
                                    <a asp-action="Details" asp-route-id="@item.MovieId">
                                        <figure class="card-banner">
                                            <img src="~/filmlane/assets/images/@item.Photopath" alt="@item.Title movie poster">
                                        </figure>
                                    </a>

                                    <div class="title-wrapper">
                                        <a asp-action="Details" asp-route-id="@item.MovieId">
                                            <h3 class="card-title">@item.Title</h3>
                                        </a>

                                        <time datetime="@item.Releasedate?.ToString("yyyy")">@item.Releasedate?.Year</time>
                                    </div>

                                    <div class="card-meta">
                                        <div class="badge badge-outline">HD</div>

                                        <div class="duration">
                                            <ion-icon name="time-outline"></ion-icon>
                                            <time datetime="@item.Movieduration.ToString()">@item.Movieduration min</time>
                                        </div>

                                        <div class="rating">
                                            <ion-icon name="star"></ion-icon>
                                            <data>NR</data>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </section>



        <!--
      - #SERVICE
    -->

        <section class="service">
            <div class="container">

                <div class="service-banner">
                    <figure>
                        <img src="~/filmlane/assets/images/service-banner.jpg" alt="HD 4k resolution! only $3.99">
                    </figure>

                </div>

                <div class="service-content">

                    <p class="service-subtitle">Our Services</p>

                    <h2 class="h2 service-title">Explore Adapted Movies.</h2>

                    <p class="service-text">
                        "Discover your favorite books brought to life on the big screen. Experience the magic of literature in stunning HD quality."
                    </p>

                    <ul class="service-list">

                        <li>
                            <div class="service-card">

                                <div class="card-icon">
                                    <ion-icon name="tv"></ion-icon>
                                </div>

                                <div class="card-content">
                                    <h3 class="h3 card-title">Enjoy on Your TV.</h3>

                                    <p class="card-text">
                                        "Bring the cinematic experience home by watching your favorite adaptations on the big screen."
                                    </p>
                                </div>

                            </div>
                        </li>

                        <li>
                            <div class="service-card">

                                <div class="card-icon">
                                    <ion-icon name="videocam"></ion-icon>
                                </div>

                                <div class="card-content">
                                    <h3 class="h3 card-title">Access Anywhere.</h3>

                                    <p class="card-text">
                                        "Dive into these adapted films from any device, anytime, anywhere."
                                    </p>
                                </div>

                            </div>
                        </li>

                    </ul>

                </div>

            </div>
        </section>





