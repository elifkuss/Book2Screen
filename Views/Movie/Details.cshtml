<main>
    <article>
        <!-- #MOVIE DETAIL -->
        <section class="movie-detail">
            <div class="container">
                <figure class="movie-detail-banner">
                    <img src="~/filmlane/assets/images/@Model.Photopath" alt="@Model.Title movie poster">
                    <button class="play-btn">
                        <ion-icon name="play-circle-outline"></ion-icon>
                    </button>
                </figure>

                <div class="movie-detail-content">
                    <p class="detail-subtitle">Movie Detail</p>

                    <h1 class="h1 detail-title">
                        @Model.Title
                    </h1>

                    <div class="meta-wrapper">
                        <div class="badge-wrapper">
                            <div class="badge badge-fill">PG 13</div>
                            <div class="badge badge-outline">HD</div>
                        </div>

                        <div class="genre-wrapper">
                            <a href="#">@Model.Movietype</a>
                        </div>

                        <div class="date-time">
                            <div>
                                <ion-icon name="calendar-outline"></ion-icon>
                                <time datetime="@Model.Releasedate?.ToString("yyyy")">@Model.Releasedate?.Year</time>
                            </div>

                            <div>
                                <ion-icon name="time-outline"></ion-icon>
                                <time datetime="PT@Model.Movieduration">@Model.Movieduration min</time>
                            </div>
                        </div>
                    </div>


                    <div class="details-actions">
                        <button class="share">
                            <ion-icon name="share-social"></ion-icon>
                            <span>Share</span>
                        </button>

                        <div class="title-wrapper">
                            <p class="title">Prime Video</p>
                            <p class="text">Streaming Channels</p>
                        </div>

                        <button class="btn btn-primary">
                            <ion-icon name="play"></ion-icon>
                            <span>Watch Now</span>
                        </button>
                    </div>

                    <a href="~/filmlane/assets/images/@Model.Photopath" download class="download-btn">
                        <span>Download</span>
                        <ion-icon name="download-outline"></ion-icon>
                    </a>
                </div>
            </div>
        </section>

        <!-- #CAST -->
        <!--<section class="movie-cast">
        <div class="container">
            <h3>Cast</h3>
            <ul>
                @foreach (var actor in Model.Actors)
                {
                    <li>@actor.Name</li>
                }
            </ul>
        </div>
    </section>-->
        <section class="comments-section">
            <h2>Comments</h2>
            <ul>
                @if (Model.Comments != null && Model.Comments.Any())
                {
                    @foreach (var comment in Model.Comments)
                    {
                        <li class="comment">
                            <span class="user-id">@comment.Id</span>
                            <span class="comment-text">@comment.CommentText</span>
                        </li>
                    }
                }
                else
                {
                    <p>No comments yet.</p>
                }
            </ul>

            <div class="add-comment-section">
                <h3>Add a Comment</h3>
                @if (User.Identity.IsAuthenticated)
                {
                    <form asp-action="Create" asp-controller="Comment" method="post">
                        <input type="hidden" name="movieId" value="@Model.MovieId" />
                        <input type="hidden" name="bookId" value="" />
                        <textarea name="commentText" rows="4" cols="50" placeholder="Write your comment here..."></textarea>
                        <br />
                        <button type="submit" class="btn btn-primary">
                            <ion-icon name="send-outline"></ion-icon>
                            <span>Add Comment</span>
                        </button>
                    </form>
                }
                else
                {
                    <p>You need to <a asp-controller="User" asp-action="Login">login</a> to add a comment.</p>
                }
            </div>
        </section>
